---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  getPublishedPosts,
  postHref,
  formatDay,
  isDraft,
} from '../../lib/posts';

const recent = await getPublishedPosts();
---

<BaseLayout title="Writing">
  <div class="fh-section-label" style="margin-top: 8px;"><span>All writing</span></div>
  <ul class="fh-list">
    {
      recent.map((p) => (
        <li class="fh-list-item">
          <span class="fh-list-date">{formatDay(p.data.date)}</span>
          <span class="fh-list-title">
            <a href={postHref(p)}>{p.data.title}</a>
            {isDraft(p) && <em class="fh-draft-tag">[draft]</em>}
          </span>
        </li>
      ))
    }
  </ul>
</BaseLayout>
