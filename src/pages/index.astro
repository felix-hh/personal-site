---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CONTACT, BIO_INTRO } from '../consts';

// Education + Experience, newest first. Each entry: logo + name + role + a
// one-line detail. Logos live in public/logos/.
const education = [
  {
    logo: '/logos/northwestern.png',
    name: 'Northwestern University',
    role: 'MS Computer Science · BS Physics & Economics',
    detail: 'McCormick School of Engineering. Kellogg Certificate in Managerial Analytics. 3.81 GPA.',
  },
];

const experience = [
  {
    logo: '/logos/nooks.png',
    name: 'Nooks',
    role: 'Product Engineer',
    detail: 'Building the AI-powered sales platform for outbound teams.',
  },
  {
    logo: '/logos/citadel.png',
    name: 'Citadel',
    role: 'Software Engineer Intern · Credit Quantitative Development',
    detail: 'Rearchitected pricing engine with asyncio, reducing p95 latency by 30x.',
  },
  {
    logo: '/logos/nuna.png',
    name: 'Nuna Healthcare',
    role: 'Software Engineer Intern · Data Foundation',
    detail: 'Designed data lake architecture and built multi-tenant data ingestion pipelines on AWS.',
  },
  {
    logo: '/logos/kleiner-perkins.png',
    name: 'Kleiner Perkins',
    role: 'Engineering Fellow',
    detail: 'Selected for the KP Engineering Fellowship program.',
  },
  {
    logo: '/logos/aws-color.svg',
    name: 'Amazon Web Services',
    role: 'Software Development Engineer Intern · Elastic MapReduce',
    detail: 'Built feature release service, JupyterLab extensions, and EMR Console auth flows.',
  },
  {
    logo: '/logos/mccormick.png',
    name: 'Computational Photography Lab',
    role: 'Research Assistant · NLP & Computational Photography',
    detail: 'Ran LLM experiments on multi-GPU setups and automated hologram data collection hardware.',
  },
  {
    logo: '/logos/instra.png',
    name: 'Instra.ai',
    role: 'Co-founder',
    detail: 'Trained a YOLOv5 model for surgical instrument detection; deployed via AWS Lambda.',
  },
];

const reads = [
  'A Gentleman in Moscow',
  'Project Hail Mary',
  'Churchill: Walking with Destiny',
  'Database Design for Mere Mortals',
];
---

<BaseLayout>
  <header class="fh-bio-header">
    <div class="fh-bio-heading">
      <h1 class="fh-h1">Felix Haba</h1>
      <p class="fh-meta">San Francisco, CA · Northwestern University, 2024</p>
    </div>
    <img class="fh-portrait" src="/profile.jpg" alt="Felix Haba" width="140" height="140" />
  </header>

  <p class="fh-p">{BIO_INTRO}</p>

  <p class="fh-p">
    In my free time, I boulder, hike, explore nature and hang out with friends, and when
    inspiration hits, I hack on <a href="https://accessmrf.com">accessmrf.com</a> which builds
    on a thesis idea I worked on during undergrad. I also love to read — I enjoy many genres,
    including biographies, fantasy books (hi Brandon Sanderson), fiction and non-fiction,
    anything I can get my hands on. My favorite game is foosball, but I don't get to play it
    often.
  </p>

  <h2 class="fh-h2">Education</h2>
  <ul class="fh-roles">
    {
      education.map((o) => (
        <li class="fh-role">
          <img class="fh-role-logo" src={o.logo} alt={`${o.name} logo`} />
          <div class="fh-role-body">
            <p class="fh-role-name">{o.name}</p>
            <p class="fh-role-title">{o.role}</p>
            <p class="fh-role-detail">{o.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h2 class="fh-h2">Experience</h2>
  <ul class="fh-roles">
    {
      experience.map((o) => (
        <li class="fh-role">
          <img class="fh-role-logo" src={o.logo} alt={`${o.name} logo`} />
          <div class="fh-role-body">
            <p class="fh-role-name">{o.name}</p>
            <p class="fh-role-title">{o.role}</p>
            <p class="fh-role-detail">{o.detail}</p>
          </div>
        </li>
      ))
    }
  </ul>

  <h2 class="fh-h2">Recent Reads</h2>
  <ul class="fh-reads">
    {reads.map((r) => <li>{r}</li>)}
  </ul>

  <h2 class="fh-h2">Projects</h2>
  <p class="fh-p">
    <strong><a href="https://accessmrf.com">AccessMRF</a>.</strong> A large-scale data catalog that aims to make available machine
    readable files containing medical insurer pricing. I am using this dataset for my
    healthcare economics thesis.
  </p>
  <p class="fh-p">
    <strong>Hippo.</strong> Medical service cost catalog using hospital price transparency data
    to provide gross charge estimates of IL and CA hospitals. The data is scraped online from
    every hospital website, converted to a SQLite table and search capabilities are powered via
    OpenAI GPT-3 and property filters. I also delivered a talk on how I built it at Wildhacks
    2023, my college's hackathon.
  </p>
  <p class="fh-p">
    <strong>Instra.ai.</strong> Surgical instrument detection using transfer learning on
    YoloV5. Deployed on a webapp using AWS Lambda and on hardware. I also wrote a report for
    course credit here.
  </p>

  <h2 class="fh-h2">Resume</h2>
  <p class="fh-p">The full PDF has dates, projects, and a one-line summary for each role.</p>
  <a href="https://drive.google.com/file/d/18onP_0r-Nk5hQVgQ9WqlDxNaG-E16voB/view" class="fh-download">Download resume (PDF)</a>

  <h2 class="fh-h2">Contact</h2>
  <p class="fh-p">
    The fastest way to reach me is <a href={`mailto:${CONTACT.email}`}>email</a>. I'm also on
    <a href={CONTACT.github}>GitHub</a> and <a href={CONTACT.linkedin}>LinkedIn</a>, and the
    writing here has an <a href="/rss.xml">RSS feed</a>.
  </p>
</BaseLayout>
